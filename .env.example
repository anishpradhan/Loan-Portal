# Copy to .env and fill in. Never commit the real .env.

# Database password (used by the db, app and backup containers)
DB_PASSWORD=

# Random string, at least 32 characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# First administrator, created only when the database has no users.
# You will be asked to change this password at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true once the app is served over HTTPS (e.g. behind nginx/IIS/Caddy)
COOKIE_SECURE=false

# Host port and backup settings
APP_PORT=3000
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30

# Optional: pull Postgres from a private registry/mirror instead of Docker Hub
# POSTGRES_IMAGE=registry.example.local/postgres:16-alpine
